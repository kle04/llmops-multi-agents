# =============================================================================
# RAGAs Evaluation Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp env.example .env

# =============================================================================
# Google API Configuration (Required for RAGAs Evaluation)
# =============================================================================
# This is REQUIRED for RAGAs evaluation as it uses LLM to evaluate metrics
GOOGLE_API_KEY=your_google_api_key_here

# Note: The script uses RAGAs' native HuggingFace embeddings (no OpenAI API key needed)
# The script uses ragas.embeddings.HuggingFaceEmbeddings directly, which does not
# require OpenAI API key. If you have OPENAI_API_KEY set in your environment, the
# script will temporarily unset it to prevent RAGAs from trying to use OpenAI embeddings.

# RAGAs LLM Model (Optional)
# Default: gemini-1.5-flash
# Other options: gemini-1.5-pro, gemini-pro, etc.
RAGAS_LLM_MODEL=gemini-1.5-flash

# =============================================================================
# Qdrant Vector Database Configuration (Optional)
# =============================================================================
# Only needed if you're running prepare_ragas_dataset.py
# Default: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Qdrant API Key (Optional - leave empty if not using cloud Qdrant)
QDRANT_API_KEY=

# Qdrant Collection Name (Optional)
# Default: mental_health_advisor
QDRANT_COLLECTION=mental_health_advisor

# =============================================================================
# Embedding Model Configuration (Optional)
# =============================================================================
# Only needed if you're running prepare_ragas_dataset.py
# Default: intfloat/multilingual-e5-base
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# =============================================================================
# Retrieval Settings (Optional)
# =============================================================================
# Only needed if you're running prepare_ragas_dataset.py
# Number of top documents to retrieve
TOP_K_DOCUMENTS=5

# Similarity threshold for retrieval
SIMILARITY_THRESHOLD=0.7

